{
  "name": "nalara",
  "private": true,
  "type": "module",
  "description": "NALARA monorepo: public website, founder OS, and API.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/web.e2e.mjs",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
