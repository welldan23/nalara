{
  "name": "@nalara/api",
  "private": true,
  "type": "module",
  "description": "NALARA API: sole owner of business logic, database access and authorization (ADR-002).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=../../.env src/main.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:status": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts --check",
    "founder:bootstrap": "node --env-file-if-exists=../../.env src/cli/bootstrap-founder.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
