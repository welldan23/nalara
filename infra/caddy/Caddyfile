# NALARA edge proxy (P0-013, ADR-006). The only component with published ports (80/443).
#
#   SITE_ADDRESS  public host name, e.g. nalara.example (no scheme)
#   CADDY_TLS     ACME contact email for public certificates, or "internal" for Caddy's local
#                 CA (HTTPS rehearsal without DNS, never for the public site)
{
	admin off
	# Production: HSTS below is safe only once the real domain serves valid certificates.
}

{$SITE_ADDRESS} {
	tls {$CADDY_TLS}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# Default policy, only for responses that bring none (the "?" prefix): API JSON, images,
		# build assets. HTML pages send their own per-request nonce policy (apps/web/proxy.ts,
		# ADR-017), which this never overrides. Nothing served without one may run scripts.
		?Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
		-X-Powered-By
	}

	# 1 MB for every request, except image uploads to the media library (P1-09): 5 MiB images
	# travel as base64 in JSON. The API re-checks the session before it reads that body.
	@media_upload {
		method POST
		path /api/v1/os/media
	}
	@not_media_upload {
		not {
			method POST
			path /api/v1/os/media
		}
	}
	request_body @media_upload {
		max_size 8MB
	}
	request_body @not_media_upload {
		max_size 1MB
	}

	# Readiness is for the internal healthcheck only (ADR-006, K-16).
	@internal path /health/ready
	respond @internal 404

	# Never trust a client-supplied request ID: the API will log Caddy's per-request UUID.
	@api path /api/* /health/live
	handle @api {
		reverse_proxy api:4000 {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				resp_headers>Set-Cookie delete
				request>uri query {
					delete token
					delete code
				}
			}
		}
	}
}
