# NALARA environment template. Copy to .env and replace EVERY placeholder.
# Never commit .env. Never paste real values into chat, issues, logs or screenshots.
# The API refuses to start while any placeholder below is still present.

# development | test | production (required, no default)
NODE_ENV=development

# Public origin of the site, no path. https is required in production.
APP_BASE_URL=http://localhost:3000

# Internal URL the web app uses to reach the API (server-side only).
API_BASE_URL=http://localhost:4000

# PostgreSQL connection for the application role nalara_app (ADR-003).
# The password must equal DB_APP_PASSWORD below.
DATABASE_URL=postgres://nalara_app:REPLACE_WITH_DB_APP_PASSWORD@localhost:5432/nalara

# Connection for the Phase 2 worker role nalara_worker (P2-02), used only by the worker process.
# The password must equal DB_WORKER_PASSWORD below.
WORKER_DATABASE_URL=postgres://nalara_worker:REPLACE_WITH_DB_WORKER_PASSWORD@localhost:5432/nalara

# Connection for the DDL role nalara_migrator, used only by `db:migrate`.
# The password must equal DB_MIGRATOR_PASSWORD below.
DATABASE_MIGRATOR_URL=postgres://nalara_migrator:REPLACE_WITH_DB_MIGRATOR_PASSWORD@localhost:5432/nalara

# Optional. Must start with __Host- in production (ADR-004).
SESSION_COOKIE_NAME=__Host-nalara_session

# HMAC key for CSRF tokens, at least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# AES-256-GCM key for TOTP secrets, base64 of exactly 32 bytes (ADR-005).
# Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# fatal | error | warn | info | debug | trace (debug/trace are rejected in production)
LOG_LEVEL=info

# API listen port
PORT=4000

# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDRs).
# compose.prod.yaml sets this to Caddy's fixed address; leave unset otherwise.
# TRUSTED_PROXIES=

# Public launch switch (ADR-015). false: published articles stay off the public site (404).
# Set to true only when the founder decides to launch.
PUBLIC_SITE_ENABLED=false

# Tests only (refused in production): API requests per minute per client IP, default 300.
# RATE_LIMIT_MAX=

# Used only by the one-time founder bootstrap CLI (P0-007), never by the server.
# FOUNDER_EMAIL=founder@example.invalid

# Optional backup target for backup scripts (ADR-007, decision D-04 pending).
# BACKUP_DESTINATION=

# --- Agent runner only (P3-03, ADR-020; not read by the API) ---
# The API's internal address. The runner has no database credentials.
AGENT_GATEWAY_URL=http://api:4000
# Printed once by `agent:credential create <label>` on the server. Never paste it in chat.
AGENT_TOKEN=REPLACE_WITH_AGENT_TOKEN_FROM_CLI
# Optional: which roles run, and how often (seconds).
# AGENT_ROLES=radar,penulis,pemeriksa,periset,pemantau
# AGENT_INTERVAL_SECONDS=1800
# AI provider (decision D-25). Until AI_BASE_URL is set the runner stays idle. OpenAI-compatible,
# https only, e.g. https://api.provider.example/v1.
# Founder's choice (D-25): OpenCode Go, https://opencode.ai/inference/go/openai/v1
# AI_BASE_URL=
AI_API_KEY=REPLACE_WITH_AI_PROVIDER_KEY
# AI_MODEL=
# Optional: a different model per role (falls back to AI_MODEL).
# AI_MODEL_RADAR=
# AI_MODEL_PENULIS=
# AI_MODEL_PEMERIKSA=
# AI_MODEL_PERISET=
# AI_MODEL_PEMANTAU=

# --- Founder Telegram bot (P3-04, decision D-26). Off until these are set. ---
# Bot token from @BotFather, read by the worker only (it sends the messages). Never paste it in chat.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TOKEN_FROM_BOTFATHER
# Random 32+ characters [A-Za-z0-9_-], read by the API (webhook) and the setup command.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
# Numeric ids of the founder's Telegram account and of the chat with the bot.
# TELEGRAM_FOUNDER_USER_ID=
# TELEGRAM_CHAT_ID=

# --- Docker Compose / db/init only (not read by the API) ---
# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_SUPERUSER_PASSWORD
DB_MIGRATOR_PASSWORD=REPLACE_WITH_DB_MIGRATOR_PASSWORD
DB_APP_PASSWORD=REPLACE_WITH_DB_APP_PASSWORD
DB_WORKER_PASSWORD=REPLACE_WITH_DB_WORKER_PASSWORD

# --- Caddy edge proxy (compose.prod.yaml, P0-013) ---
# Public host name without scheme.
SITE_ADDRESS=nalara.example
# ACME contact email for real certificates, or "internal" for a local-CA rehearsal only.
CADDY_TLS=internal
